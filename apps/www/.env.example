# 環境変数を追加するときは、ビルド時・実行時のどちらで必要かを確認する。
# デプロイ用のビルドは GitHub Actions 上で行う。Vercel の Secret は vercel pull で
# 実際の値を取得できないため、ビルド時に必要な公開設定（NEXT_PUBLIC_* など）は
# Vercel の Config に登録し、秘密情報は GitHub Actions Secrets から明示的に渡す。
# 実行時だけ必要な秘密情報は Vercel の Secret に登録する。ビルド中のモジュール初期化にも
# 値が必要なら .github/workflows/vercel.yml の Build deployment artifacts にダミー値を用意する。
# PR のビルド成功だけで判断せず、デプロイ用ビルドで値を取得できることと実行時の動作も確認する。
GOOGLE_ANALYTICS_ID=
API_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
DATABASE_URL=
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8787
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PREFIX=better-auth
AUTH_CROSS_SUBDOMAIN_COOKIES=false
API_CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8787
LOG_LEVEL=
DISCORD_FEEDBACK_WEBHOOK_URL=
NEXT_PUBLIC_SENTRY_DSN=
